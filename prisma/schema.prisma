generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// -------------------------------------
// Better Auth Core Schema (Admins)
// -------------------------------------

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]
  
  // Custom permissions and role for Admin
  role          String?   @default("admin") // "admin" or "superadmin"
  permissions   String?   // JSON string of permissions like ["read", "write", "delete"]
  
  // We can still support username/password through Better Auth plugins
  // but better auth requires email by default, we can use username as email or add username field.
  username      String?   @unique

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

// -------------------------------------
// Dominator XI Specific Models
// -------------------------------------

model Member {
  id                 String      @id @default(uuid())
  fullName           String
  phoneNumber        String?
  birthDate          DateTime
  province           String
  city               String
  fcMobileNickname   String
  ovr                Int
  status             String      @default("pending") // pending, accepted, rejected
  reason             String?     // Rejection reason if any (e.g. Parent Permission)
  warningAccept      Boolean     @default(false)     // True if under 15 and warning accepted
  joinDate           DateTime    @default(now())
  
  screenings         Screening[]

  @@map("members")
}

model Screening {
  id        String   @id @default(uuid())
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  question  String
  answer    String
  createdAt DateTime @default(now())

  @@map("screenings")
}

model PageVisit {
  id        String   @id @default(uuid())
  page      String   @unique
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@map("page_visits")
}

model Setting {
  id    String @id @default(uuid())
  key   String @unique
  value String

  @@map("settings")
}

model ActivityLog {
  id        String   @id @default(uuid())
  adminId   String
  action    String
  target    String?
  createdAt DateTime @default(now())

  @@map("activity_logs")
}

model TopPlayer {
  id        String   @id @default(uuid())
  name      String
  role      String
  image     String?
  stats     String?
  playstyle String?
  ovr       Int      @default(0)
  skillMoves Int     @default(0)
  weakFoot   Int     @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("top_players")
}

model Tactic {
  id        String   @id @default(uuid())
  formation String   @unique
  buildUp   String?
  offense   String?
  defense   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tactics")
}

// -------------------------------------
// Tournament Bracket
// -------------------------------------

model Tournament {
  id              String   @id @default(uuid())
  name            String
  description     String?
  bracketType     String   @default("single") // single | double
  status          String   @default("draft") // draft | open | closed | match | finished
  maxParticipants Int      @default(16)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  entries TournamentEntry[]
  matches TournamentMatch[]

  @@map("tournaments")
}

model TournamentEntry {
  id           String  @id @default(uuid())
  tournamentId String
  nickname     String
  phoneNumber  String
  displayName  String?
  seed         Int?

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  asPlayer1 TournamentMatch[] @relation("MatchPlayer1")
  asPlayer2 TournamentMatch[] @relation("MatchPlayer2")
  asWinner  TournamentMatch[] @relation("MatchWinner")

  createdAt DateTime @default(now())

  @@unique([tournamentId, phoneNumber])
  @@unique([tournamentId, nickname])
  @@map("tournament_entries")
}

model TournamentMatch {
  id             String  @id @default(uuid())
  tournamentId   String
  round          Int
  bracketSide    String  @default("winners") // winners | losers | final
  matchIndex     Int
  player1EntryId String?
  player2EntryId String?
  winnerEntryId  String?
  nextMatchId    String?
  nextSlot       Int? // 1 | 2
  loserNextMatchId String?
  loserNextSlot    Int?
  status         String  @default("pending") // pending | ready | done

  tournament Tournament       @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  player1    TournamentEntry? @relation("MatchPlayer1", fields: [player1EntryId], references: [id], onDelete: SetNull)
  player2    TournamentEntry? @relation("MatchPlayer2", fields: [player2EntryId], references: [id], onDelete: SetNull)
  winner     TournamentEntry? @relation("MatchWinner", fields: [winnerEntryId], references: [id], onDelete: SetNull)
  nextMatch  TournamentMatch? @relation("MatchToNext", fields: [nextMatchId], references: [id], onDelete: SetNull)
  fromMatches TournamentMatch[] @relation("MatchToNext")
  loserNextMatch TournamentMatch? @relation("LoserToNext", fields: [loserNextMatchId], references: [id], onDelete: SetNull)
  fromLoserMatches TournamentMatch[] @relation("LoserToNext")

  @@index([tournamentId, bracketSide, round])
  @@map("tournament_matches")
}
